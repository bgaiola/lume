# =============================================================================
# Lume — example environment file
# Copy to `.env` at the repo root, then to each app/service that needs it.
# Real secrets must NEVER be committed.
# =============================================================================

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---- Branding / domains ----------------------------------------------------
# Canonical product domain. Default placeholder until lume.app is acquired.
LUME_PUBLIC_URL=http://localhost:5173
LUME_CLIENT_PUBLIC_URL=http://localhost:5174
LUME_API_PUBLIC_URL=http://localhost:3000
LUME_SIGNALING_PUBLIC_URL=ws://localhost:3001

# ---- Database (PostgreSQL 16) ----------------------------------------------
POSTGRES_USER=lume
POSTGRES_PASSWORD=lume_dev_password
POSTGRES_DB=lume
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lume:lume_dev_password@localhost:5432/lume?schema=public

# ---- Redis (sessions, cache, BullMQ) ---------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO (S3-compatible, future recordings storage) ----------------------
MINIO_ROOT_USER=lume_minio
MINIO_ROOT_PASSWORD=lume_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=lume_minio
S3_SECRET_KEY=lume_minio_dev_password
S3_BUCKET=lume-recordings
S3_REGION=auto

# ---- Auth ------------------------------------------------------------------
# JWT signing secret. Generate with: openssl rand -hex 64
JWT_SECRET=replace_me_with_64_random_hex_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Magic link tokens (separate secret to limit blast radius)
MAGIC_LINK_SECRET=replace_me_with_another_64_random_hex_chars
MAGIC_LINK_TTL=15m

# ---- Email (Resend) --------------------------------------------------------
# https://resend.com — generate an API key after verifying the sending domain.
RESEND_API_KEY=re_replace_me
EMAIL_FROM="Lume <hello@lume.app>"
EMAIL_REPLY_TO=support@lume.app

# ---- OAuth providers (Phase 1: optional, can be filled in later) -----------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# ---- WebRTC / TURN ---------------------------------------------------------
# Local coturn (development). Production should use Cloudflare Calls TURN.
TURN_URL=turn:localhost:3478
TURN_USERNAME=lume
TURN_PASSWORD=lume_dev_turn_password
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# ---- Signaling service -----------------------------------------------------
SIGNALING_PORT=3001
SIGNALING_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- API service -----------------------------------------------------------
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Web (panel) -----------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_SIGNALING_URL=ws://localhost:3001

# ---- Client-web (end-customer screen share UI) ----------------------------
VITE_CLIENT_API_URL=http://localhost:3000
VITE_CLIENT_SIGNALING_URL=ws://localhost:3001
