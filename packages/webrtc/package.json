{
  "name": "@lume/webrtc",
  "version": "0.1.0",
  "private": true,
  "description": "Lume WebRTC browser SDK. LumeHost (technician, receives stream) and LumeClient (customer, sends stream).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no tests in this package' && exit 0"
  },
  "dependencies": {
    "@lume/protocol": "workspace:*",
    "socket.io-client": "^4.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4"
  }
}
