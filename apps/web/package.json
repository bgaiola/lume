{
  "name": "@lume/web",
  "version": "0.1.0",
  "private": true,
  "description": "Lume technician panel (React + Vite + Tailwind + shadcn/ui).",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5173",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty",
    "test": "echo 'no tests yet' && exit 0",
    "clean": "rm -rf dist .turbo *.tsbuildinfo node_modules/.vite"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@lume/protocol": "workspace:*",
    "@lume/shared": "workspace:*",
    "@lume/webrtc": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.78.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.78.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  }
}
